# Mealie configuration
MEALIE_URL=https://mealie.example.com
MEALIE_TOKEN=your_mealie_api_token

# Home Assistant configuration for GET|POST /move
HA_URL=https://home-assistant.example.com
HA_TOKEN=your_home_assistant_long_lived_access_token

# Cookidoo configuration for GET|POST /move/cookidoo
COOKIDOO_EMAIL=your_cookidoo_email@example.com
COOKIDOO_PASSWORD=your_cookidoo_password

# Optional Cookidoo localization
COOKIDOO_COUNTRY=pl
COOKIDOO_LANGUAGE=pl-PL

# Optional Cookidoo cookie cache file
COOKIDOO_COOKIES_FILE=.cookidoo-cookies

# Optional Mealie meal plan note configuration for GET|POST /move/cookidoo/plan
MEALIE_COOKIDOO_PLAN_ENTRY_TYPE=dinner
MEALIE_COOKIDOO_PLAN_TITLE=Cookidoo
